@page "/ConnectionTests"
@rendermode InteractiveServer
@using AS24Net.Domain
@using AS24Net.Services.ConnectionTests

<HxCard>
    <HeaderTemplate>
        <h5 class="card-title me-auto">Connection tests</h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p class="small text-body-secondary" style="max-width: 60rem;">
            A test checks the configuration of the partner and of the identity (certificates, public URL), opens the TCP
            connection, runs the TLS handshake with the partner's server certificate checked as when sending and asks for
            the partner's URL with a <code>GET</code>, with its HTTP authentication. No message and no MDN is sent and the
            send queue is not touched. The partners are tested one after another; every test is in the transfer log.
            Click a partner or a connection to change it; the test runs again when it is saved.
        </p>

        <div class="d-flex flex-wrap gap-2 align-items-end mb-3">
            <div style="min-width: 22rem;">
                <HxSelect TItem="Identity" TValue="int?" Label="Test as identity"
                          Data="identities" @bind-Value="identityId"
                          TextSelector="@(i => $"{i.Name} ({i.As2Id})")" ValueSelector="@(i => (int?)i.Id)"
                          Nullable="true" NullText="-the default identity of each partner-" />
            </div>
            <HxButton Color="ThemeColor.Primary" Icon="BootstrapIcon.PlayFill" Enabled="CanStart"
                      OnClick="() => Start(partners)">Test all</HxButton>
            <HxButton Color="ThemeColor.Secondary" Icon="BootstrapIcon.ArrowRepeat" Enabled="CanStart && Failed.Count > 0"
                      OnClick="() => Start(Failed)">Test failed again (@Failed.Count)</HxButton>
            @if (Tests.IsRunning)
            {
                <HxButton Color="ThemeColor.Secondary" Icon="BootstrapIcon.StopFill" OnClick="Tests.Cancel">Stop</HxButton>
                <span class="small text-body-secondary align-self-center">
                    <HxSpinner Size="SpinnerSize.Small" Color="ThemeColor.Secondary" /> @Tests.Progress.Done of @Tests.Progress.Total
                </span>
            }
        </div>

        @if (Tests.Results.Count > 0)
        {
            <div class="small mb-2">
                <HxBadge Color="ThemeColor.Success">@Tests.Results.Values.Count(r => r.Success) succeeded</HxBadge>
                <HxBadge Color="ThemeColor.Danger">@Failed.Count failed</HxBadge>
                <HxBadge Color="ThemeColor.Secondary">@(partners.Count - partners.Count(p => Tests.Results.ContainsKey(p.Id))) not tested</HxBadge>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Partner</th>
                        <th>URL</th>
                        <th>Result</th>
                        <th>Details</th>
                        <th>Tested</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var partner in partners)
                    {
                        var result = Tests.Results.GetValueOrDefault(partner.Id);
                        <tr>
                            <td>
                                <button type="button" class="btn btn-link p-0 fw-bold text-start @(partner.Enabled ? "" : "text-body-secondary text-decoration-line-through")"
                                        title="Edit the partner" @onclick="() => EditPartnerAsync(partner)">@partner.Name</button>
                                <div class="small text-body-secondary a24-code">@partner.As2Id</div>
                            </td>
                            <td class="small text-break" style="max-width: 20rem;">
                                <button type="button" class="btn btn-link btn-sm p-0 text-start" title="Edit the connection, shared by its partners"
                                        @onclick="() => EditConnectionAsync(partner.Connection)">@partner.Connection.Name</button>
                                <div>@partner.Connection.Url</div>
                            </td>
                            <td>
                                @if (Tests.Current == partner.Id)
                                {
                                    <HxSpinner Size="SpinnerSize.Small" Color="ThemeColor.Secondary" />
                                }
                                else if (result is not null)
                                {
                                    <HxBadge Color="@ResultColor(result)">@ResultText(result)</HxBadge>
                                }
                            </td>
                            <td class="small" style="max-width: 36rem;">
                                @if (result is not null)
                                {
                                    <ConnectionTestDetails Result="result" />
                                    @if (!result.Success && partner.Connection.Contacts.Count > 0)
                                    {
                                        <div class="mt-1 text-body-secondary">Contacts:</div>
                                        @foreach (var contact in partner.Connection.Contacts)
                                        {
                                            <PartnerContactView Contact="contact" />
                                        }
                                    }
                                }
                            </td>
                            <td class="small text-nowrap">
                                @if (result is not null)
                                {
                                    <div>@result.Tested.ToString("g")</div>
                                    <div class="text-body-secondary">@result.Duration.TotalSeconds.ToString("F1") s as @result.Identity</div>
                                }
                            </td>
                            <td class="text-nowrap">
                                <HxButton Size="ButtonSize.Small" Color="ThemeColor.Secondary" Icon="BootstrapIcon.PlayFill"
                                          Tooltip="Test this partner" Enabled="CanStart" OnClick="() => Start([partner])" />
                                @if (result is not null && IsHttps(partner))
                                {
                                    <HxButton Size="ButtonSize.Small" Color="ThemeColor.Secondary" Icon="BootstrapIcon.ShieldLock"
                                              Tooltip="Use the HTTPS server's certificate as the partner's signature certificate"
                                              Enabled="!Tests.IsRunning && fetching is null" OnClick="() => ShowServerCertificateAsync(partner)" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </BodyTemplate>
</HxCard>

<HxModal @ref="partnerEditModal" ShowCloseButton="true" Size="ModalSize.ExtraLarge" Scrollable="true">
    <HeaderTemplate>Partner @editedPartner?.Name</HeaderTemplate>
    <BodyTemplate>
        @if (editedPartner is not null)
        {
            <PartnerForm Partner="editedPartner" Connections="connections" Identities="identities" OwnCertificates="ownCertificates"
                         OnSaved="HandlePartnerSavedAsync" />
        }
    </BodyTemplate>
</HxModal>

<HxModal @ref="connectionEditModal" ShowCloseButton="true" Size="ModalSize.ExtraLarge" Scrollable="true">
    <HeaderTemplate>Connection @editedConnection?.Name</HeaderTemplate>
    <BodyTemplate>
        @if (editedConnection is not null)
        {
            <ConnectionForm Connection="editedConnection" Certificates="certificates" OnSaved="HandleConnectionSavedAsync" />
        }
    </BodyTemplate>
</HxModal>

<HxModal @ref="serverCertificateModal" Title="@($"HTTPS certificate of {serverCertificatePartner?.Name}")" ShowCloseButton="true" Size="ModalSize.Large">
    <BodyTemplate>
        @if (serverCertificate is { } certificate && serverCertificatePartner is { } partner)
        {
            var expired = certificate.ValidTo < Now || certificate.ValidFrom > Now;
            var current = partner.Connection.SignatureCertificate;
            <dl class="row small mb-3">
                <dt class="col-sm-3">Server</dt>
                <dd class="col-sm-9 a24-code">@certificate.Host</dd>
                <dt class="col-sm-3">Subject</dt>
                <dd class="col-sm-9 text-break">@certificate.Subject</dd>
                <dt class="col-sm-3">Issued by</dt>
                <dd class="col-sm-9 text-break">@certificate.Issuer</dd>
                <dt class="col-sm-3">Valid</dt>
                <dd class="col-sm-9 @(expired ? "text-danger" : "")">@certificate.ValidFrom.ToString("g") – @certificate.ValidTo.ToString("g")</dd>
                <dt class="col-sm-3">SHA-256</dt>
                <dd class="col-sm-9 a24-code text-break">@certificate.Sha256Fingerprint</dd>
                <dt class="col-sm-3">Current signature certificate</dt>
                <dd class="col-sm-9 text-break">
                    @if (current is null)
                    {
                        <span class="text-body-secondary">none</span>
                    }
                    else
                    {
                        @current.Name<span class="@(current.ValidTo < Now ? "text-danger" : "text-body-secondary")">, valid to @current.ValidTo.ToString("d")</span>
                    }
                </dd>
            </dl>
            @if (expired)
            {
                <HxAlert Color="ThemeColor.Danger" CssClass="small mb-0">The server's certificate is not valid now and cannot be used.</HxAlert>
            }
            else
            {
                <HxAlert Color="ThemeColor.Warning" CssClass="small mb-0">
                    The certificate becomes the signature certificate of connection <strong>@partner.Connection.Name</strong>, so of all
                    its partners, right away. Use it only when the partner signs its AS2 messages with the key of its HTTPS server;
                    most partners use another certificate for AS2, and their messages and MDNs would then be refused.
                    Compare the SHA-256 fingerprint with the one the partner gives you. The current certificate stays accepted as the
                    previous one, and the change is in <em>Certificate changes</em> and the log.
                </HxAlert>
            }
        }
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Text="Use as signature certificate" Color="ThemeColor.Primary" Icon="BootstrapIcon.ShieldCheck"
                  Enabled="@(serverCertificate is { } c && c.ValidFrom <= Now && c.ValidTo >= Now)" OnClick="UseServerCertificateAsync" />
    </FooterTemplate>
</HxModal>
