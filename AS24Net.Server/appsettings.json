{
  "UploadBasePath": "uploads",
  "LogDirectory": "logs",
  "ConnectionStrings": {
    "AS24Net": ""
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "DataProtection": {
    "KeysDirectory": "keys"
  },
  "ReverseProxy": {
    "TrustAll": false
  },
  "Certificates": {
    "GenerateCertificate": true
  },
  "Hooks": {
    "TimeoutSeconds": 60
  },
  "Webhooks": {
    "AllowPrivateNetworks": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
