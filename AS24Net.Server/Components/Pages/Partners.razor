@page "/Partners"
@rendermode InteractiveServer
@using AS24Net.DataLayer.Filters
@using AS24Net.Domain
<style>
    .scrollable-table-container {
        overflow: auto;
        height: calc(100vh - 160px);
    }
</style>
<HxModal @ref="partnerEditModal" ShowCloseButton="true" Size="ModalSize.ExtraLarge" Scrollable="true">
    <HeaderTemplate>
        @(currentPartner?.Id > 0 ? $"Partner {currentPartner.Name}" : "New partner")
    </HeaderTemplate>
    <BodyTemplate>
        @if (currentPartner is not null)
        {
            <EditForm Model="@currentPartner" OnValidSubmit="SavePartner">
                <DataAnnotationsValidator />

                <div class="row g-2">
                    <div class="col-md-6"><HxInputText Label="Name" @bind-Value="@currentPartner.Name" /></div>
                    <div class="col-md-6"><HxInputText Label="AS2 name" Hint="AS2-To of our messages, AS2-From of the partner's." @bind-Value="@currentPartner.As2Id" InputCssClass="a24-code" /></div>
                    <div class="col-md-12">
                        <HxSelect TItem="Connection" TValue="int" Label="Connection"
                                  Hint="The partner's server: URL, security, MDN and certificates, shared by the partners that differ only in the AS2 name."
                                  Data="connections" @bind-Value="@currentPartner.ConnectionId"
                                  TextSelector="@(c => $"{c.Name} ({c.Url})")" ValueSelector="@(c => c.Id)" Nullable="false" />
                        <div class="small text-body-secondary">
                            <a href="Connections">A new connection</a> is set up in Connections.
                        </div>
                    </div>
                    <div class="col-md-12"><HxInputText Label="Description" @bind-Value="@currentPartner.Description" /></div>
                    <div class="col-md-6">
                        <HxSelect TItem="Identity" TValue="int?" Label="Default identity" Hint="We send from it when the message names no identity."
                                  Data="identities" @bind-Value="@currentPartner.DefaultIdentityId"
                                  TextSelector="@(i => $"{i.Name} ({i.As2Id})")" ValueSelector="@(i => (int?)i.Id)" Nullable="true" NullText="-none-" />
                    </div>
                    <div class="col-md-6"><HxInputText Label="Content type" Hint="Media type of the payload when the message names none, e.g. application/edifact." @bind-Value="@currentPartner.ContentType" /></div>
                    <div class="col-md-6"><HxInputText Label="Subject" Hint="Subject of our messages; the file name when empty." @bind-Value="@currentPartner.Subject" /></div>
                    <div class="col-md-6"><HxCheckbox Label="Enabled" Text="Messages are sent to the partner and accepted from it" @bind-Value="@currentPartner.Enabled" /></div>
                </div>

                <HxSubmit Color="ThemeColor.Primary" CssClass="mt-4">Save</HxSubmit>
            </EditForm>
        }
    </BodyTemplate>
</HxModal>

<HxModal @ref="connectionTestModal" ShowCloseButton="true" Size="ModalSize.Large">
    <HeaderTemplate>
        Test the connection to @connectionTestPartner?.Name
    </HeaderTemplate>
    <BodyTemplate>
        @if (connectionTestPartner is not null)
        {
            <ConnectionTestForm Partner="connectionTestPartner" Identities="identities" />
        }
    </BodyTemplate>
</HxModal>

<HxListLayout Title="Partners" TFilterModel="PartnerFilter"
              @bind-FilterModel="filterModel"
              @bind-FilterModel:after="gridComponent.RefreshDataAsync">
    <CommandsTemplate>
        <HxButton Text="New partner" Color="ThemeColor.Primary" Icon="BootstrapIcon.PlusLg" OnClick="HandleNewItemClicked" />
        <a class="btn btn-secondary" href="ConnectionTests"><HxIcon Icon="BootstrapIcon.Plug" /> Connection tests</a>
    </CommandsTemplate>
    <FilterTemplate Context="filterContext">
        <HxInputText Label="Name, AS2 name or connection" @bind-Value="filterContext.Name" />
    </FilterTemplate>
    <DataTemplate>
        <HxGrid @ref="gridComponent"
                ContentNavigationMode="GridContentNavigationMode.Pagination"
                PageSize="1000"
                TableContainerCssClass="scrollable-table-container"
                HeaderRowCssClass="sticky-top"
                TItem="Partner"
                DataProvider="GetGridData"
                SelectedDataItem="currentPartner"
                SelectedDataItemChanged="HandleSelectedAsync"
                Responsive="true"
                PreserveSelection="false">
            <Columns>
                <HxGridColumn HeaderText="Name" SortKeySelector="d => d.Name" IsDefaultSortColumn="true">
                    <ItemTemplate Context="p">
                        <span class="@(p.Enabled ? "" : "text-body-secondary text-decoration-line-through")">@p.Name</span>
                    </ItemTemplate>
                </HxGridColumn>
                <HxGridColumn HeaderText="AS2 name" ItemTextSelector="@(d => d.As2Id)" SortKeySelector="d => d.As2Id" ItemCssClass="a24-code"/>
                <HxGridColumn HeaderText="Connection" SortKeySelector="d => d.Connection.Name">
                    <ItemTemplate Context="p">
                        <a href="Connections" title="@p.Connection.Url">@p.Connection.Name</a>
                    </ItemTemplate>
                </HxGridColumn>
                <HxGridColumn HeaderText="Content type" ItemTextSelector="@(d => d.ContentType)" SortKeySelector="d => d.ContentType" ItemCssClass="small"/>

                <HxContextMenuGridColumn Context="partner">
                    <HxContextMenu>
                        <HxContextMenuItem Text="Edit" Icon="BootstrapIcon.Pen" OnClick="async () => await HandleSelectedAsync(partner)" />
                        <HxContextMenuItem Text="Send a file" Icon="BootstrapIcon.Send" OnClick="@(() => Navigation.NavigateTo($"Outgoing?partner={partner.Id}"))" />
                        <HxContextMenuItem Text="Test connection" Icon="BootstrapIcon.Plug" OnClick="async () => await HandleTestConnectionClick(partner)" />
                        <HxContextMenuItem Text="Schedule a certificate" Icon="BootstrapIcon.CalendarPlus" OnClick="@(() => Navigation.NavigateTo($"CertificateChanges?connection={partner.ConnectionId}"))" />
                        <HxContextMenuItem Text="Delete" Icon="BootstrapIcon.Trash" OnClick="async () => await HandleDeleteClick(partner)"
                                           ConfirmationQuestion="@($"Delete partner {partner.Name}? Its messages in the send queue are deleted too.")"/>
                    </HxContextMenu>
                </HxContextMenuGridColumn>
            </Columns>
        </HxGrid>
    </DataTemplate>
</HxListLayout>
