<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <!-- Secrets of the development machine (dotnet user-secrets), stored in the profile of the user. -->
        <UserSecretsId>3bd779e3-1eec-4d9c-93d2-b3887caa91c0</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <!-- The Zabbix template is downloaded from Settings / Monitoring, so it is part of the application. -->
      <EmbeddedResource Include="..\samples\zabbix\as24net_by_http.yaml" LogicalName="$(MSBuildProjectName).as24net_by_http.yaml" Link="Monitoring\as24net_by_http.yaml" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="BitzArt.Blazor.Cookies.Server" />
      <PackageReference Include="Havit.Blazor.Components.Web.Bootstrap" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
      <PackageReference Include="Scalar.AspNetCore" />
      <PackageReference Include="Serilog" />
      <PackageReference Include="Serilog.Extensions.Logging" />
      <PackageReference Include="Serilog.Sinks.File" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\AS24Net.Core\AS24Net.Core.csproj" />
      <ProjectReference Include="..\AS24Net.DependencyInjection\AS24Net.DependencyInjection.csproj" />
    </ItemGroup>

</Project>
